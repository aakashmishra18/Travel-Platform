NODE_ENV=development
PORT=3002
SERVICE_NAME=user-service

# Point this at the same or a separate database — either works, this
# service only ever touches its own tables (see db/migrations/001_init.sql)
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/travel_system
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000

# MUST match auth-service's JWT_ACCESS_SECRET exactly — this service
# verifies the same tokens, it does not issue its own.
JWT_ACCESS_SECRET=
JWT_ISSUER=travel-os-auth-service
JWT_AUDIENCE=travel-os-internal

# MUST match api-gateway's / auth-service's INTERNAL_SERVICE_TOKEN exactly.
INTERNAL_SERVICE_TOKEN=

# Symmetric key for encrypting document numbers at rest (pgcrypto).
# Generate with: openssl rand -hex 32
DOCUMENT_ENCRYPTION_KEY=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

CORS_ALLOWED_ORIGINS=http://localhost:3000
